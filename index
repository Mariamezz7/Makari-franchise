                <div class="m-lbl">Disc.</div>
              </div>
            </div>
            <div class="partner-accounts">
              ${partnerAccounts.map(a => {
                const healthClass = a.health.includes('Healthy') || a.health.includes('🟢') ? 'health-green' :
                                    a.health.includes('🟡') ? 'health-yellow' : 'health-red';
                const statusClass = a.contractStatus.toLowerCase().includes('active') ? 'status-active' :
                                    a.contractStatus.toLowerCase().includes('renewal') ? 'status-renewal' : 'status-disc';
                return `
                  <div class="acc-row">
                    <span class="acc-name">${a.name}</span>
                    <div class="acc-right">
                      <span class="health-dot ${healthClass}"></span>
                      <span class="acc-status ${statusClass}">${a.contractStatus}</span>
                      <span style="font-size:11px;color:var(--text-muted)">${a.feedbackFlag || ''}</span>
                    </div>
                  </div>`;
              }).join('')}
            </div>
          </div>
        </div>
      `;
    }).join('');
  }

  // ── RENDER DG CARDS ──────────────────────
  function renderDGCards(dg) {
    if (dg.length === 0) {
      document.getElementById('dgGrid').innerHTML = '<p style="color:var(--text-muted)">No DG activity data found</p>';
      return;
    }
    const colors = ['#0070f2','#00c897','#ffd166','#f77f00','#ef233c'];
    document.getElementById('dgGrid').innerHTML = dg.map((d, i) => {
      const qualityPct = (d.quality / 5) * 100;
      const barColor = d.quality >= 4 ? '#00c897' : d.quality >= 3 ? '#ffd166' : '#ef233c';
      return `
        <div class="dg-card">
          <div class="dg-header">
            <div>
              <div class="dg-partner">${d.partner}</div>
              <div style="font-size:11px;color:var(--text-muted);margin-top:3px">${d.week} · ${d.industry}</div>
            </div>
            <span class="dg-play">${(d.salesPlay || '').split(' ').slice(0,3).join(' ')}</span>
          </div>
          <div class="dg-score-bar">
            <div class="dg-score-label">
              <span>DG Quality Score</span>
              <span style="color:${barColor};font-weight:700">${d.quality}/5</span>
            </div>
            <div class="score-track">
              <div class="score-fill" style="width:${qualityPct}%;background:${barColor}"></div>
            </div>
          </div>
          <div class="dg-stats">
            <div class="dg-stat"><div class="sv">${d.leads}</div><div class="sl">Leads</div></div>
            <div class="dg-stat"><div class="sv">${d.mqls}</div><div class="sl">MQLs</div></div>
            <div class="dg-stat"><div class="sv">${d.sqls}</div><div class="sl">SQLs</div></div>
            <div class="dg-stat"><div class="sv">${d.tal}</div><div class="sl">TAL</div></div>
            <div class="dg-stat"><div class="sv">${d.linkedin}</div><div class="sl">LinkedIn</div></div>
            <div class="dg-stat"><div class="sv">${d.events}</div><div class="sl">Events</div></div>
            <div class="dg-stat"><div class="sv">${d.emailCampaigns}</div><div class="sl">Emails</div></div>
            <div class="dg-stat"><div class="sv">${d.demos}</div><div class="sl">Demos</div></div>
          </div>
          ${d.notes ? `<div style="margin-top:10px;font-size:11px;color:var(--text-muted);font-style:italic;border-top:1px solid var(--border);padding-top:8px">${d.notes}</div>` : ''}
        </div>
      `;
    }).join('');
  }

  // ── RENDER FEEDBACK ──────────────────────
  function renderFeedback(feedback) {
    if (feedback.length === 0) {
      document.getElementById('feedbackList').innerHTML = '<p style="color:var(--text-muted)">No feedback entries found</p>';
      return;
    }
    document.getElementById('feedbackList').innerHTML = feedback.map(f => {
      const isUrgent = String(f.urgency).includes('Urgent') || String(f.urgency).includes('🚨');
      const urgIcon = isUrgent ? '🚨' : '⚠️';
      const tagCls = isUrgent ? 'fb-urgent' : 'fb-normal';
      return `
        <div class="feedback-item">
          <div class="fb-urgency">${urgIcon}</div>
          <div class="fb-main">
            <div class="fb-title">${f.account} — <span style="color:var(--text-muted)">${f.partner}</span></div>
            <div class="fb-detail">${f.feedback}</div>
            ${f.action ? `<div style="margin-top:6px;font-size:11px;color:var(--sap-blue)">→ Action: ${f.action}</div>` : ''}
            ${f.blocker ? `<div style="margin-top:4px;font-size:11px;color:var(--sap-red)">🚧 Blocker: ${f.blocker}</div>` : ''}
            ${f.competitive ? `<div style="margin-top:4px;font-size:11px;color:var(--sap-yellow)">🏴 Competitive: ${f.competitive}</div>` : ''}
            ${f.expansion ? `<div style="margin-top:4px;font-size:11px;color:var(--sap-green)">📈 Expansion: ${f.expansion}</div>` : ''}
          </div>
          <div class="fb-meta">
            <div class="fb-date">${f.date}</div>
            <span class="fb-tag ${tagCls}">${f.type || 'Intel'}</span>
            <div style="margin-top:6px;font-size:10px">Due: ${f.due || '—'}</div>
            <div style="font-size:10px;color:var(--text-muted)">${f.owner || ''}</div>
          </div>
        </div>
      `;
    }).join('');
  }

  // ── UTILS ────────────────────────────────
  function fmtCurrency(val) {
    if (!val || isNaN(val)) return '€0';
    if (val >= 1000000) return '€' + (val / 1000000).toFixed(2) + 'M';
    if (val >= 1000) return '€' + (val / 1000).toFixed(0) + 'K';
    return '€' + val.toLocaleString();
  }
  function fmtCurrencyShort(val) {
    if (!val || isNaN(val)) return '€0';
    if (val >= 1000000) return '€' + (val/1000000).toFixed(1) + 'M';
    return '€' + (val/1000).toFixed(0) + 'K';
  }
</script>
</body>
</html>
