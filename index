    const upside    = forecast.filter(f => f.stage.toLowerCase() === 'upside').reduce((s,f)=>s+f.acv,0);
    const total     = committed + probable + upside;
    const closeWeek = forecast.filter(f => f.closeThisWeek.toLowerCase() === 'yes').length;
    const atRisk    = forecast.filter(f => f.health.toLowerCase().includes('risk') || f.health.includes('🔴')).length;

    document.getElementById('forecastBar').innerHTML = `
      <div class="fc-block fc-commit">
        <div class="fc-label">💚 Committed</div>
        <div class="fc-val" style="color:var(--sap-green)">${fmtCurrency(committed)}</div>
        <div class="fc-sub">${forecast.filter(f=>f.stage.toLowerCase()==='commit').length} deals</div>
      </div>
      <div class="fc-block fc-probable">
        <div class="fc-label">🟡 Probable</div>
        <div class="fc-val" style="color:var(--sap-yellow)">${fmtCurrency(probable)}</div>
        <div class="fc-sub">${forecast.filter(f=>f.stage.toLowerCase()==='probable').length} deals</div>
      </div>
      <div class="fc-block fc-upside">
        <div class="fc-label">🔴 Upside</div>
        <div class="fc-val" style="color:var(--sap-red)">${fmtCurrency(upside)}</div>
        <div class="fc-sub">${forecast.filter(f=>f.stage.toLowerCase()==='upside').length} deals</div>
      </div>
      <div class="fc-block fc-total" style="border-top-color:var(--sap-blue)">
        <div class="fc-label">📊 Total Pipeline</div>
        <div class="fc-val" style="color:#fff">${fmtCurrency(total)}</div>
        <div class="fc-sub">${forecast.length} total deals</div>
      </div>
      <div class="fc-block" style="border-top:3px solid var(--sap-yellow)">
        <div class="fc-label">🏁 Close This Week</div>
        <div class="fc-val" style="color:var(--sap-yellow)">${closeWeek}</div>
        <div class="fc-sub">deals expected to close</div>
